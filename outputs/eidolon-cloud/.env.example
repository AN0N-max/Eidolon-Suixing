# These variables are read from the process environment, not from a file automatically.
EIDOLON_CLOUD_DATA=/var/lib/eidolon-cloud
EIDOLON_CLOUD_HOST=127.0.0.1
EIDOLON_CLOUD_PORT=8787
# Explicit diagnostics only; there is no model/provider configured in this framework stage.
EIDOLON_CLOUD_DIAGNOSTICS=0
# Opt-in offline TTS protocol test; fixed silence only, NO Fish/paid transport.
# Use a NEW dedicated data directory and port 8788 for this development snapshot.
EIDOLON_CLOUD_TTS_MOCK=0
